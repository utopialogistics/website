# Actual public domain, including https://. Leave empty for local preview.
# On Netlify this is set automatically for deploys if you prefer; otherwise set it
# in Site configuration > Environment variables so canonical and social URLs resolve.
PUBLIC_SITE_URL=

# Optional override. Quote submissions are handled by Netlify Forms out of the box,
# configured in src/data/site.ts. Set this only to route the form to a DIFFERENT
# provider instead; it takes precedence over Netlify. It must be an HTTPS URL or a
# same-origin absolute path accepting URL-encoded POST requests.
# Never put an API secret here - this value is public.
PUBLIC_QUOTE_ENDPOINT=
