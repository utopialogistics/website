---
import '@fontsource-variable/manrope';
import '@fontsource-variable/inter';
import '../styles/global.css';
import { site } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title: pageTitle,
  description = site.description,
  noindex = false,
} = Astro.props;
const title = pageTitle
  ? `${pageTitle} | Utopia Logistics Inc.`
  : 'Utopia Logistics Inc. | Your Freight. The Road Ahead.';
const canonical = site.url ? new URL(Astro.url.pathname, site.url).href : '';
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#142338" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {site.url && (
      <meta
        property="og:image"
        content={new URL('/images/hero-truck.webp', site.url).href}
      />
    )}
    {canonical && <meta property="og:url" content={canonical} />}
    <title>{title}</title>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
