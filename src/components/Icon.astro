  up: 'M12 20V4M5 11l7-7 7 7',
  arrow: 'M4 12h15M13 5l7 7-7 7',
  diagonal: 'M5 19 19 5M5 5h14v14',
  down: 'M12 4v16M5 13l7 7 7-7',
  truck:
    'M1 5h13v12H1zM14 9h5l4 5v3h-9M5 17a2 2 0 1 0 .01 0M18 17a2 2 0 1 0 .01 0M17 9v5h6',
  pin: 'M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0ZM15 10a3 3 0 1 1-6 0 3 3 0 0 1 6 0',
  globe:
    'M22 12A10 10 0 1 1 2 12a10 10 0 0 1 20 0ZM2 12h20M12 2c-6 6-6 14 0 20 6-6 6-14 0-20Z',
