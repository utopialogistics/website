---
import { site, navigation } from '../data/site';
import Icon from './Icon.astro';
const path = Astro.url.pathname;
const active = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<div class="utility-bar">
  <div class="container utility-inner">
    <span>
      <span class="green-dot"></span> Milton, Ontario · Moving across North
      America
    </span>
    <div>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={site.phoneHref}>
        <Icon name="phone" size={13} />
        {site.phone}
      </a>
    </div>
  </div>
</div>
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Utopia Logistics Inc. home">
      <img
        src="/images/utopia-logo.svg"
        alt="Utopia Logistics Inc. — Delivering Your Dreams"
        width="1695"
        height="293"
      />
    </a>
    <nav class="desktop-nav" aria-label="Main navigation">
      {navigation.map((item) => (
        <a
          href={item.href}
          aria-current={active(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <a href="/request-quote/" class="button button-primary header-quote">
      Request a Quote <Icon size={17} />
    </a>
    <button
      class="menu-toggle"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Open navigation menu"
    >
      <Icon name="menu" class="menu-open-icon" />
      <Icon name="close" class="menu-close-icon" />
    </button>
  </div>
  <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation" hidden>
    {navigation.map((item) => (
      <a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>
        {item.label}
        <Icon name="diagonal" size={18} />
      </a>
    ))}
    <a href="/request-quote/" class="mobile-quote">
      Request a Quote <Icon size={18} />
    </a>
    <a href={site.phoneHref} class="mobile-phone">
      <Icon name="phone" size={17} />
      {site.phone}
    </a>
  </nav>
  <noscript>
    <nav class="no-script-nav" aria-label="Section navigation">
      {navigation.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
      <a href="/request-quote/">Request a Quote</a>
    </nav>
  </noscript>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.querySelector<HTMLElement>('#mobile-nav');
  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute(
        'aria-label',
        open ? 'Close navigation menu' : 'Open navigation menu',
      );
      menu.hidden = !open;
    };
    toggle.addEventListener('click', () => setOpen(Boolean(menu.hidden)));
    menu
      .querySelectorAll('a')
      .forEach((link) => link.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (
        event.target instanceof Node &&
        !document.querySelector('.site-header')?.contains(event.target)
      )
        setOpen(false);
    });
    window
      .matchMedia('(min-width: 981px)')
      .addEventListener('change', (event) => {
        if (event.matches) setOpen(false);
      });
  }
</script>
