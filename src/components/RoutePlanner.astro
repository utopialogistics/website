---
import Icon from './Icon.astro';
---

<form
  class="route-planner"
  action="/request-quote/"
  method="get"
  aria-label="Plan your shipment route"
>
  <div class="route-intro">
    <Icon name="route" size={27} />
    <div>
      <strong>Where to next?</strong>
      <span>Let’s start with your route.</span>
    </div>
  </div>
  <div class="route-field">
    <label for="route-pickup">PICKUP CITY</label>
    <div>
      <span class="route-dot"></span>
      <input
        id="route-pickup"
        name="pickup_city"
        placeholder="Where from?"
        maxlength="160"
        required
        autocomplete="off"
      />
    </div>
  </div>
  <span class="route-connector" aria-hidden="true">
    <Icon size={18} />
  </span>
  <div class="route-field">
    <label for="route-delivery">DELIVERY CITY</label>
    <div>
      <span class="route-dot destination-dot"></span>
      <input
        id="route-delivery"
        name="delivery_city"
        placeholder="Where to?"
        maxlength="160"
        required
        autocomplete="off"
      />
    </div>
  </div>
  <button class="button button-primary" type="submit">
    Plan my shipment <Icon size={18} />
  </button>
</form>
