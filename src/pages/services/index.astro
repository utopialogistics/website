---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import FaqList from '../../components/FaqList.astro';
import { services } from '../../data/site';
import { publishedOptionalServices } from '../../data/optional-services';
import {
  serviceSections,
  ftlLtlComparison,
  serviceFaqs,
} from '../../data/content';
---

<Layout
  title="Freight Services — FTL, LTL, Cross-Border & Long-Haul"
  description="Explore full truckload, less than truckload, Canada–U.S. cross-border, and North American long-haul freight services from Utopia Logistics in Milton, Ontario."
>
  <PageHero
    eyebrow="Our services"
    title={'Freight services for the way\nyour business moves.'}
    description="From smaller pallet shipments to full truckloads, explore transportation options across Canada and North America."
    ctaLabel="Request a Quote"
    ctaHref="/request-quote/"
  />

  <nav class="service-jump" aria-label="Services on this page">
    <div class="container">
      <span>Jump to</span>
      <div class="section-nav">
        {services.map((service) => (
          <a href={`#${service.slug}`}>{service.shortTitle}</a>
        ))}
        <a href="#ftl-or-ltl">FTL or LTL?</a>
      </div>
    </div>
  </nav>

  <section class="section service-blocks">
    <div class="container">
      {services.map((service) => {
        const section =
          serviceSections[service.slug as keyof typeof serviceSections];
        return (
          <article class="service-block" id={service.slug}>
            <div class="service-media">
              <img
                src={service.image}
                alt={service.alt}
                width="900"
                height="580"
                loading="lazy"
                decoding="async"
                style={`object-position:${service.position}`}
              />
              <span class="image-corner" aria-hidden="true">
                {service.label.toUpperCase()}
              </span>
            </div>
            <div class="service-copy">
              <p class="eyebrow">
                {service.number} / {service.label}
              </p>
              <h2>
                <Icon name={service.icon} size={26} />
                {service.title}
              </h2>
              <p class="service-lead">{service.description}</p>
              {section.explains.map((paragraph) => (
                <p class="body-copy">{paragraph}</p>
              ))}
              <h3 class="best-for-heading">Best suited to</h3>
              <ul class="tick-list">
                {section.bestFor.map((item) => (
                  <li>
                    <Icon name="check" size={16} />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
              <p class="inline-note">{section.note}</p>
              <div class="service-actions">
                <a href={service.cta.href} class="button button-primary">
                  {service.cta.label} <Icon size={18} />
                </a>
                <a href={`/services/${service.slug}/`} class="text-link">
                  More detail <Icon size={17} />
                  <span class="sr-only">about {service.title}</span>
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section class="section light-section" id="ftl-or-ltl">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Choosing between them</p>
          <h2 class="section-title" id="compare-heading">
            FTL or LTL?
          </h2>
        </div>
        <p>
          Two ways to use a trailer. Which one suits a shipment depends on its
          size, packaging, route, and requirements, so dispatch confirms the fit
          for each enquiry.
        </p>
      </div>
      <div
        class="table-scroll"
        role="region"
        aria-labelledby="compare-heading"
        tabindex="0"
      >
        <table class="compare-table">
          <thead>
            <tr>
              <th scope="col">What to consider</th>
              <th scope="col">Full truckload (FTL)</th>
              <th scope="col">Less than truckload (LTL)</th>
            </tr>
          </thead>
          <tbody>
            {ftlLtlComparison.map((row) => (
              <tr>
                <th scope="row">{row.aspect}</th>
                <td>{row.ftl}</td>
                <td>{row.ltl}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <ul class="compare-cards">
        {ftlLtlComparison.map((row) => (
          <li>
            <h3>{row.aspect}</h3>
            <div>
              <span>Full truckload (FTL)</span>
              <p>{row.ftl}</p>
            </div>
            <div>
              <span>Less than truckload (LTL)</span>
              <p>{row.ltl}</p>
            </div>
          </li>
        ))}
      </ul>
      <p class="inline-note table-note">
        Descriptions are general guidance. Utopia does not apply fixed pallet or
        weight cutoffs to decide between FTL and LTL; every shipment is assessed
        on its own details.
      </p>
      <div class="compare-actions">
        <a href="/request-quote/?shipment_type=ftl" class="button button-light">
          Request an FTL Quote <Icon size={17} />
        </a>
        <a href="/request-quote/?shipment_type=ltl" class="button button-light">
          Request an LTL Quote <Icon size={17} />
        </a>
      </div>
    </div>
  </section>

  {publishedOptionalServices.length > 0 && (
    <section class="section" id="additional-services">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Also available</p>
            <h2 class="section-title">Additional services.</h2>
          </div>
        </div>
        <div class="related-grid">
          {publishedOptionalServices.map((service) => (
            <div class="optional-card">
              <Icon name={service.icon} size={24} />
              <h3>{service.title}</h3>
              <p>{service.description}</p>
              <a href="/request-quote/" class="text-link">
                Discuss this service <Icon size={17} />
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container faq-section-grid">
      <div>
        <p class="eyebrow">Before we plan the trip</p>
        <h2 class="section-title">
          Service
          <br />
          questions.
        </h2>
        <a href="/faq/" class="text-link">
          View all FAQs <Icon size={18} />
        </a>
      </div>
      <FaqList items={serviceFaqs} />
    </div>
  </section>

  <CtaBand
    eyebrow="Still deciding"
    title="Not sure which service fits?"
    description="Tell us what you’re shipping, where it needs to go, and your preferred dates. We’ll help you explore the options."
    ctaLabel="Discuss Your Shipment"
    ctaHref="/request-quote/"
  />
</Layout>

<style>
  .service-jump {
    border-bottom: 1px solid var(--line);
    padding-block: 22px;
  }
  .service-jump .container {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .service-jump > .container > span {
    flex: none;
    font-size: 10px;
    font-weight: 650;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--muted);
  }
  .service-jump .section-nav {
    margin-top: 0;
  }
  .service-blocks {
    padding-bottom: 40px;
  }
  .service-block {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: 60px;
    align-items: center;
    scroll-margin-top: 120px;
  }
  .service-block + .service-block {
    margin-top: 90px;
    padding-top: 90px;
    border-top: 1px solid var(--line);
  }
  .service-block:nth-child(even) .service-media {
    order: 2;
  }
  .service-media {
    position: relative;
  }
  .service-media img {
    width: 100%;
    height: 420px;
    object-fit: cover;
    border-radius: 5px;
  }
  .service-copy h2 {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 18px;
    font-size: clamp(26px, 2.6vw, 36px);
    letter-spacing: -1.1px;
    line-height: 1.2;
    font-weight: 600;
  }
  .service-copy h2 :global(svg) {
    flex: none;
    color: var(--blue);
  }
  .service-lead {
    margin-top: 20px;
    font-size: 15px;
    line-height: 1.8;
    color: var(--navy);
  }
  .service-copy .body-copy {
    margin-top: 16px;
    font-size: 14px;
  }
  .best-for-heading {
    margin-top: 30px;
    font-size: 10px;
    font-weight: 650;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--blue);
  }
  .tick-list {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .tick-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 13px;
    line-height: 1.7;
    color: var(--navy);
  }
  .tick-list :global(svg) {
    flex: none;
    margin-top: 3px;
    color: var(--green);
  }
  .service-copy .inline-note {
    margin-top: 24px;
  }
  .service-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 18px 30px;
    margin-top: 30px;
  }
  /* FTL / LTL comparison */
  .table-scroll {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 5px;
    background: #fff;
  }
  .table-scroll:focus-visible {
    outline: 3px solid var(--blue);
    outline-offset: 3px;
  }
  .compare-table {
    width: 100%;
    min-width: 660px;
    border-collapse: collapse;
    text-align: left;
  }
  .compare-table th,
  .compare-table td {
    padding: 18px 22px;
    vertical-align: top;
    border-bottom: 1px solid var(--line);
  }
  .compare-table thead th {
    background: var(--navy);
    color: #fff;
    font-size: 11px;
    font-weight: 650;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    border-bottom: 0;
  }
  .compare-table tbody th {
    width: 22%;
    font-size: 13px;
    font-weight: 600;
    color: var(--navy);
  }
  .compare-table tbody td {
    font-size: 13px;
    line-height: 1.8;
    color: var(--muted);
  }
  .compare-table tbody tr:last-child th,
  .compare-table tbody tr:last-child td {
    border-bottom: 0;
  }
  /* Narrow screens get the same rows stacked, so nothing is hidden off-screen. */
  .compare-cards {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 14px;
  }
  .compare-cards li {
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: 5px;
    background: #fff;
  }
  .compare-cards h3 {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.3px;
    color: var(--navy);
  }
  .compare-cards li > div {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }
  .compare-cards span {
    display: block;
    font-size: 10px;
    font-weight: 650;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: var(--blue);
  }
  .compare-cards p {
    margin-top: 8px;
    font-size: 13px;
    line-height: 1.8;
    color: var(--muted);
  }
  .table-note {
    margin-top: 18px;
  }
  .compare-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 28px;
  }
  .optional-card {
    padding: 30px;
    border: 1px solid var(--line);
    border-radius: 5px;
  }
  .optional-card :global(svg) {
    color: var(--blue);
  }
  .optional-card h3 {
    margin-top: 16px;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.5px;
  }
  .optional-card p {
    margin: 12px 0 20px;
    font-size: 13px;
    line-height: 1.8;
    color: var(--muted);
  }
  @media (max-width: 980px) {
    .service-block {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
    .service-block:nth-child(even) .service-media {
      order: 0;
    }
    .service-block + .service-block {
      margin-top: 60px;
      padding-top: 60px;
    }
    .service-media img {
      height: 300px;
    }
  }
  @media (max-width: 800px) {
    .table-scroll {
      display: none;
    }
    .compare-cards {
      display: grid;
    }
  }
  @media (max-width: 620px) {
    .service-jump .container {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }
    .service-media img {
      height: 230px;
    }
    .service-actions {
      flex-direction: column;
      align-items: stretch;
      gap: 20px;
    }
    .service-actions .text-link {
      align-self: flex-start;
    }
    .compare-actions .button {
      width: 100%;
    }
  }
</style>
