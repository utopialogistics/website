---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import FaqList from '../../components/FaqList.astro';
import { services, site } from '../../data/site';
import { serviceDetails } from '../../data/content';
export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}
const { service } = Astro.props;
const detail = serviceDetails[service.slug as keyof typeof serviceDetails];
const related = services.filter((item) => item.slug !== service.slug);
---

<Layout
  title={service.title}
  description={`${detail.intro} Contact Utopia Logistics in Milton, Ontario to discuss your route.`}
>
  <PageHero
    eyebrow={service.shortTitle}
    title={detail.heading}
    description={detail.intro}
    image={service.image}
    alt={service.alt}
    parent="Services"
    parentHref="/services/"
  />
  <section class="section">
    <div class="container split-grid">
      <div class="split-copy">
        <p class="eyebrow">{service.label}</p>
        <h2 class="section-title">{detail.title}</h2>
        <p class="body-copy">{detail.body}</p>
        <a class="button button-primary" href={service.quoteHref}>
          Request a Quote <Icon size={18} />
        </a>
      </div>
      <div class="service-checklist">
        <span class="checklist-overline">
          YOUR SHIPMENT / THE STARTING POINT
        </span>
        <h3>Let’s start with the details.</h3>
        <ol class="numbered-list">
          {detail.points.map((point, i) => (
            <li>
              <span>{String(i + 1).padStart(2, '0')}</span>
              <div>{point}</div>
            </li>
          ))}
        </ol>
        <p class="inline-note">{detail.note}</p>
      </div>
    </div>
  </section>
  <section class="service-dispatch">
    <div class="container">
      <div>
        <span class="green-dot"></span>
        <p>Prefer to talk through the trip?</p>
      </div>
      <a href={site.phoneHref}>
        {site.phone} <Icon name="diagonal" size={18} />
      </a>
      <a href={`mailto:${site.email}`}>
        {site.email} <Icon name="diagonal" size={18} />
      </a>
    </div>
  </section>
  <section class="section">
    <div class="container faq-section-grid">
      <div>
        <p class="eyebrow">Good to know</p>
        <h2 class="section-title">
          Questions about
          <br />
          the journey.
        </h2>
      </div>
      <FaqList items={detail.faq} />
    </div>
  </section>
  <section class="section light-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Explore your options</p>
          <h2 class="section-title">More ways to move.</h2>
        </div>
        <a href="/services/" class="text-link">
          All services <Icon size={18} />
        </a>
      </div>
      <div class="related-grid">
        {related.map((item) => (
          <a href={`/services/${item.slug}/`} class="related-service">
            <div>
              <h3>{item.shortTitle}</h3>
              <p>{item.label}</p>
            </div>
            <Icon name="diagonal" size={25} />
          </a>
        ))}
      </div>
    </div>
  </section>
  <CtaBand />
</Layout>
<style>
  .service-checklist {
    padding: 35px;
    background: var(--light);
    border: 1px solid var(--line);
    border-radius: 5px;
  }
  .checklist-overline {
    font-size: 8px;
    letter-spacing: 1.6px;
    color: var(--blue);
  }
  .service-checklist h3 {
    font-size: 24px;
    font-weight: 550;
    letter-spacing: -0.6px;
    margin-top: 18px;
  }
  .service-checklist .numbered-list {
    margin-top: 25px;
  }
  .service-checklist .numbered-list li:last-child {
    padding-bottom: 5px;
  }
  .service-checklist .inline-note {
    font-size: 10px;
  }
  .service-dispatch {
    background: var(--navy);
    color: #fff;
  }
  .service-dispatch > .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    padding-block: 30px;
  }
  .service-dispatch .container > div {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 13px;
  }
  .service-dispatch a {
    font-size: 12px;
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .service-dispatch a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  @media (max-width: 980px) {
    .service-checklist {
      padding: 28px;
    }
    .service-dispatch > .container {
      flex-wrap: wrap;
      gap: 20px;
    }
    .service-dispatch .container > div {
      width: 100%;
    }
  }
  @media (max-width: 480px) {
    .service-checklist {
      padding: 25px;
    }
    .service-checklist h3 {
      font-size: 22px;
    }
    .service-dispatch > .container {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
    .service-dispatch a {
      font-size: 12px;
    }
    .service-dispatch .container > div {
      font-size: 12px;
    }
  }
</style>
